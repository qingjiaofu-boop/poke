      "steps": [
        {
          "type": "play_animation",
          "animation": "ferroseed_evolution",
          "position": [
            40,
            56
          ],
          "duration_ms": 2200
        },
        {
          "type": "dialogue",
          "preload": "ferrothorn_left.png",
          "speaker": "坚果哑铃",
          "text": "身体……感觉好重……"
        },
        {
          "type": "dialogue",
          "preload": "grotle_right.png",
          "speaker": "树林龟",
          "text": "哈哈，刚进化确实会有这种感觉。"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_bottom.png",
          "speaker": "",
          "text": "这是树林龟，是我种子哑铃……不对，是我坚果哑铃最要好的朋友。"
        },
        {
          "type": "dialogue",
          "preload": "grotle_right.png",
          "speaker": "树林龟",
          "text": "不过这也说明你的身体里有了新的力量。"
        },
        {
          "type": "dialogue",
          "preload": "ferrothorn_left.png",
          "speaker": "坚果哑铃",
          "text": "真的？"
        },
        {
          "type": "dialogue",
          "preload": "grotle_right.png",
          "speaker": "树林龟",
          "text": "来我们平时锻炼的地方吧，我教你两招。"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_center.png",
          "speaker": "",
          "text": "通过 STC 导航键控制方向进行移动"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_center.png",
          "speaker": "",
          "text": "去上面找树林龟吧！"
        },
        {
          "type": "set_flag",
          "flag": "opening_complete",
          "value": true
        }
      ]
    },

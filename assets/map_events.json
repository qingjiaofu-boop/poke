        },
        {
          "type": "dialogue",
          "preload": "no_portrait_bottom.png",
          "speaker": "陌生的声音",
          "text": "好冷……"
        },
        {
          "type": "dialogue",
          "preload": "ferrothorn_left.png",
          "speaker": "坚果哑铃",
          "text": "谁在说话！？"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_center.png",
          "speaker": "",
          "text": "……"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_bottom.png",
          "speaker": "",
          "text": "坚果哑铃重新看向悬崖。"
        },
        {
          "type": "camera_pan",
          "target": "position",
          "position": [
            33,
            5
          ],
          "duration_ms": 600
        },
        {
          "type": "wait",

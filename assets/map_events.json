        },
        {
          "type": "camera_pan",
          "target": "player",
          "position": [
            0,
            0
          ],
          "duration_ms": 900
        },
        {
          "type": "dialogue",
          "preload": "ferrothorn_left.png",
          "speaker": "坚果哑铃",
          "text": "陨石！？落在矿洞上方的平地上了？"
        },
        {
          "type": "dialogue",
          "preload": "no_portrait_bottom.png",
          "speaker": "",
